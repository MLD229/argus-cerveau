# Exemple de configuration — copier en `.env` et remplir.
#
# Le cerveau a besoin d'UNE clé : celle du modèle.
# Sans elle, l'agent démarre mais ne peut pas répondre.

# Cle API DeepSeek (obligatoire). Remplacer par une vraie cle.
# A creer sur https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=REMPLACER_PAR_VOTRE_CLE

# --- Optionnel : dictee locale (interface avec bouton micro) ---------------
# Si l'interface hote n'a pas faster-whisper installe, mettre dans
# config.yaml : stt.provider: none
# Aucune autre variable n'est lue par le cerveau.
